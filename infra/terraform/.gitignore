# Terraform working directory and provider plugins
.terraform/

# Terraform state and backups
*.tfstate
*.tfstate.*

# Terraform plan files
*.tfplan

# Local variable files (may contain environment-specific values)
*.tfvars
*.tfvars.json

# Terraform crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
